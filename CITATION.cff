    affiliation: Saltfoss Energy ApS
url: "https://SaltfossEnergy.github.io/GFMR/"
repository-code: "https://github.com/SaltfossEnergy/GFMR"
keywords:
  - molten salt reactor
  - GFMR
  - reference specification
  - FUNaK
  - graphite
